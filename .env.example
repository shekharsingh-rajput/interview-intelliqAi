# ===== ENVIRONMENT CONFIGURATION =====
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ===== SERVER =====
# Port to run the backend server on (default: 5000)
PORT=5000

# Node environment (development, staging, production)
NODE_ENV=development

# ===== DATABASE =====
# MongoDB connection URI
# Local: mongodb://localhost:27017/interview-platform
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/interview-platform?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/interview-platform

# ===== AUTHENTICATION =====
# JWT secret key (generate with: openssl rand -base64 32)
# MUST be at least 32 characters in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT expiration time (e.g., 7d, 24h)
JWT_EXPIRES_IN=7d

# ===== AI API KEYS =====
# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=your-groq-api-key

# Optional: Alternative AI API keys (Anthropic, OpenAI, etc.)
# ANTHROPIC_API_KEY=your-anthropic-key
# OPENAI_API_KEY=your-openai-key

# ===== FRONTEND & CORS =====
# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:3000

# Allowed frontend origins (comma-separated in production)
# ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com

# ===== SECURITY =====
# HTTPS configuration (set to true in production)
USE_HTTPS=false

# Rate limiting
# Max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Password requirements
MIN_PASSWORD_LENGTH=12
REQUIRE_UPPERCASE=true
REQUIRE_NUMBERS=true

# ===== LOGGING =====
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Log file path (optional)
# LOG_FILE=/var/log/interview-platform.log

# ===== EMAIL (for future notifications) =====
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@intelliqai.com

# ===== MONITORING & ERROR TRACKING =====
# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn

# ===== API TIMEOUTS =====
# AI API timeout in milliseconds
AI_API_TIMEOUT=30000

# Database query timeout
DB_QUERY_TIMEOUT=10000

# ===== FEATURE FLAGS =====
# Enable/disable features
ENABLE_CAMERA_FEATURE=true
ENABLE_INTERVIEW_HISTORY=true
ENABLE_ANALYTICS=true

# ===== PRODUCTION CHECKLIST =====
# Before deploying to production:
# [ ] Generate a strong JWT_SECRET (32+ chars)
# [ ] Set NODE_ENV=production
# [ ] Configure MONGODB_URI to Atlas or secure database
# [ ] Set USE_HTTPS=true and configure SSL
# [ ] Update FRONTEND_URL to production domain
# [ ] Review and update rate limits
# [ ] Set up error tracking (Sentry)
# [ ] Configure logging to persistent storage
# [ ] Set up database backups
# [ ] Enable HTTPS/TLS
# [ ] Set up monitoring and alerting
